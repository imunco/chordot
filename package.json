{
  "name": "chordot-desktop",
  "version": "0.13.0",
  "private": true,
  "description": "弦点 / Chordot — 数学与物理教学作图工具",
  "author": "奇点未码 · 弦点",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,yellow \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "verify:kernel": "npm run build && electron electron/verify-kernel.cjs",
    "verify:construct": "npm run build && electron electron/verify-construct.cjs",
    "verify:file": "npm run build && electron electron/verify-file.cjs",
    "verify:decompose": "npm run build && electron electron/verify-decompose.cjs",
    "verify:sim": "npm run build && electron electron/verify-sim.cjs",
    "verify:measure": "npm run build && electron electron/verify-measure.cjs",
    "verify:conflict": "npm run build && electron electron/verify-conflict.cjs",
    "verify:3d": "npm run build && electron electron/verify-3d.cjs",
    "verify:kit": "npm run build && electron electron/verify-kit.cjs",
    "verify:motion": "npm run build && electron electron/verify-motion.cjs",
    "verify:pack": "npm run build && electron electron/verify-pack.cjs",
    "verify:props": "npm run build && electron electron/verify-props.cjs",
    "verify:touch": "npm run build && electron electron/verify-touch.cjs",
    "verify:constraint": "npm run build && electron electron/verify-constraint.cjs",
    "verify:prefs": "npm run build && electron electron/verify-prefs.cjs",
    "verify:mathinput": "npm run build && electron electron/verify-mathinput.cjs",
    "verify:polish": "npm run build && electron electron/verify-polish.cjs",
    "verify:fixes": "npm run build && electron electron/verify-fixes.cjs",
    "verify:canvas": "npm run build && electron electron/verify-canvas.cjs",
    "verify:features": "npm run build && electron electron/verify-features.cjs",
    "verify:physics": "npm run build && electron electron/verify-physics.cjs",
    "verify:annotate": "npm run build && electron electron/verify-annotate.cjs",
    "verify:groups": "npm run build && electron electron/verify-groups.cjs",
    "verify:rotate": "npm run build && electron electron/verify-rotate.cjs",
    "verify:dyn": "npm run build && electron electron/verify-dyn.cjs",
    "verify:shapeforce": "npm run build && electron electron/verify-shapeforce.cjs",
    "dist": "npm run build && electron-builder --win",
    "verify:tour": "npm run build && electron electron/verify-tour.cjs",
    "verify:update": "npm run build && electron electron/verify-update.cjs",
    "verify:persist": "npm run build && electron electron/verify-persist.cjs",
    "verify:sweep": "npm run build && electron electron/verify-sweep.cjs",
    "verify:ux": "npm run build && electron electron/verify-ux.cjs",
    "verify:edge": "npm run build && electron electron/verify-edge.cjs",
    "verify:menu": "npm run build && electron electron/verify-menu.cjs",
    "verify:dock": "npm run build && electron electron/verify-dock.cjs",
    "verify:textbook": "npm run build && electron electron/verify-textbook.cjs",
    "verify:bigscreen": "npm run build && electron electron/verify-bigscreen.cjs",
    "verify:lab2": "npm run build && electron electron/verify-lab2.cjs",
    "verify:mech": "npm run build && electron electron/verify-mech.cjs"
  },
  "dependencies": {
    "@salusoft89/planegcs": "^1.3.0",
    "cannon-es": "^0.20.0",
    "mathjs": "^15.2.0",
    "mathlive": "^0.111.4",
    "matter-js": "^0.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "cn.chordot.desktop",
    "productName": "Chordot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "!electron/verify-*.cjs",
      "!electron/screenshot.cjs",
      "package.json",
      "!node_modules/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "弦点 Chordot",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Chordot-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Chordot-${version}-${arch}-portable.${ext}"
    }
  }
}
